
### 1. user3-signup
# @name user3-signup
POST {{appUrl}}/auth/signup
x-publishable-key:pk_test_local_01
Content-Type:application/json

{
  "email": "user.three@email.com",
  "password": "u3_pw1234",
  "username": "user_three",
  "first_name": "user",
  "last_name": "three"
}

{{
  // Save Admin's token globally without affecting User B
  $global.user3 = response.parsedBody.token;
  console.log("user3 token:", $global.user3);
}}


