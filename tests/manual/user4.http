
### 1. user4-signup
# @name user4-signup
POST {{appUrl}}/auth/signup
x-publishable-key:pk_test_local_01
Content-Type:application/json

{
  "email": "user.four@email.com",
  "password": "u4_pw1234",
  "username": "user_four",
  "first_name": "user",
  "last_name": "four"
}

{{
  // Save Admin's token globally without affecting User B
  $global.user4 = response.parsedBody.token;
  console.log("user4 token:", $global.user4);
}}


