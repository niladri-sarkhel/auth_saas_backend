
### 1. user5-signup
# @name user5-signup
POST {{appUrl}}/auth/signup
x-publishable-key:pk_test_local_01
Content-Type:application/json

{
  "email": "user.five@email.com",
  "password": "u5_pw1234",
  "username": "user_five",
  "first_name": "user",
  "last_name": "five"
}

{{
  // Save Admin's token globally without affecting User B
  $global.user5 = response.parsedBody.token;
  console.log("user5 token:", $global.user5);
}}


