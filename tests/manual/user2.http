
### 1. user2-signup
# @name user2-signup
POST {{appUrl}}/auth/signup
x-publishable-key:pk_test_local_01
Content-Type:application/json

{
  "email": "user.two@email.com",
  "password": "u2_pw1234",
  "username": "user_two",
  "first_name": "user",
  "last_name": "two"
}

{{
  // Save Admin's token globally without affecting User B
  $global.user2 = response.parsedBody.token;
  console.log("user2 token:", $global.user2);
}}


